<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Bağlantı apartman_panel kullanıcısıdır. Pwd kısmına kendi parolanızı yazın. Kök hesap kullanılmaz. -->
    <add name="ApartmanDb"
         connectionString="Server=127.0.0.1;Port=3306;Database=ApartmanYonetimDB;Uid=apartman_panel;Pwd=;" />
  </connectionStrings>
  <appSettings>
    <!-- İlk kurulum şifresi yalnızca hesap yokken kullanılır. Açılışta ezilmez. -->
    <add key="AdminKullaniciAdi" value="admin" />
    <add key="AdminSifre" value="1234" />
  </appSettings>
</configuration>
