<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Kendi MySQL root şifrenizi Pwd= kısmına yazın. -->
    <add name="ApartmanDb"
         connectionString="Server=127.0.0.1;Port=3306;Database=ApartmanYonetimDB;Uid=root;Pwd=;" />
  </connectionStrings>
  <appSettings>
    <!-- İlk açılışta otomatik oluşturulur / senkronlanır. -->
    <add key="AdminKullaniciAdi" value="Admin" />
    <add key="AdminSifre" value="Admin123" />
  </appSettings>
</configuration>
